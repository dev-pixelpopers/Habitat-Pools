# WordPress REST API (headless CMS)
NEXT_PUBLIC_API_DOMAIN=hb-pools.demo-link.tech
NEXT_PUBLIC_API_URL=wp-json/wp/v2

# WordPress Contact API Handler plugin key (sent as x-api-key)
WP_API_KEY=

# Contact form email (comma-separate multiple recipients)
CONTACT_TO_EMAIL=

# Gmail SMTP (use a Google App Password, not your account password)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
CONTACT_FROM_NAME=
